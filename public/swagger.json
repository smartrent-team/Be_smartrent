        }
      }
    },

    "/api/tickets": {
      "get": {
        "tags": ["🔧 Yêu cầu Bảo trì"],
        "summary": "Lấy danh sách yêu cầu bảo trì",
        "description": "**Phân quyền:**\n- `super_admin`: Xem tất cả.\n- `manager`: Chỉ thấy tickets thuộc chi nhánh mình.\n- `tenant`: Chỉ thấy tickets của phòng mình.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "roomId", "in": "query", "schema": { "type": "integer" },                  "description": "Lọc theo phòng" },
          { "name": "status","in": "query", "schema": { "type": "string", "enum": ["pending","in-progress","resolved"] }, "description": "Lọc theo trạng thái" }
        ],
        "responses": {
          "200": { "description": "Thành công", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TicketListResponse" } } } },
          "401": { "description": "Chưa đăng nhập", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "post": {
        "tags": ["🔧 Yêu cầu Bảo trì"],
        "summary": "Gửi yêu cầu bảo trì mới",
        "description": "Thường do **Tenant** gọi khi phát hiện sự cố trong phòng. `roomId` và `tenantId` sẽ tự lấy từ hồ sơ nếu người gọi là tenant.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateTicketRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Tạo thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data":    { "$ref": "#/components/schemas/Ticket" }
                  }
                }
              }
            }
          },
          "400": { "description": "Thiếu thông tin bắt buộc", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Chưa đăng nhập",           "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },

    "/api/tickets/{id}": {
      "get": {
        "tags": ["🔧 Yêu cầu Bảo trì"],
        "summary": "Lấy chi tiết một yêu cầu bảo trì",
        "description": "**Phân quyền:**\n- `tenant` chỉ thấy ticket của phòng mình.\n- `manager` chỉ thấy ticket thuộc chi nhánh mình.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "ID ticket" }
        ],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data":    { "$ref": "#/components/schemas/Ticket" }
                  }
                }
              }
            }
          },
          "403": { "description": "Không có quyền",  "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Không tìm thấy", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Chưa đăng nhập",  "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "patch": {
        "tags": ["🔧 Yêu cầu Bảo trì"],
        "summary": "Cập nhật trạng thái yêu cầu bảo trì",
        "description": "Chỉ `manager` hoặc `super_admin` được phép gọi. Manager chỉ cập nhật được ticket thuộc chi nhánh mình.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "ID ticket" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateTicketStatusRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Cập nhật thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string", "example": "Cập nhật trạng thái thành công" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Trạng thái không hợp lệ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Không có quyền",         "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Chưa đăng nhập",         "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },

    "/api/utility/submit": {
      "post": {
        "tags": ["⚡ Điện nước (Utility)"],
        "summary": "Ghi chỉ số điện nước",
        "description": "Ghi nhận chỉ số điện và nước cho một phòng. Server tự động tính lượng tiêu thụ và cảnh báo bất thường (>50% so với tháng trước).\n\n**Phân quyền:**\n- `super_admin` và `manager` được gọi.\n- `tenant` bị chặn.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UtilitySubmitRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Ghi thành công",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UtilitySubmitResponse" } } }
          },
          "400": { "description": "Chỉ số mới nhỏ hơn tháng trước hoặc thiếu thông tin", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Tenant không có quyền hoặc phòng không thuộc chi nhánh", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Chưa đăng nhập", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },

    "/api/upload/signature": {
      "get": {
        "tags": ["📷 Tải ảnh (Upload)"],
        "summary": "Lấy chữ ký upload ảnh lên Cloudinary",
        "description": "Trả về `signature`, `timestamp`, `api_key`, `cloud_name` để client tự upload ảnh trực tiếp lên Cloudinary (không qua server).\n\n**Quy trình:**\n1. Gọi API này.\n2. Dùng thông tin trả về để sign request lên `https://api.cloudinary.com/v1_1/{cloud_name}/image/upload`.\n3. Lấy `secure_url` từ Cloudinary response để lưu vào DB.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "folder", "in": "query", "schema": { "type": "string", "default": "general" }, "description": "Tên thư mục trên Cloudinary (ví dụ: `contracts_5`)" }
        ],
        "responses": {
          "200": { "description": "Thành công", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UploadSignatureResponse" } } } },
          "401": { "description": "Chưa đăng nhập", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },

    "/api/webhooks/payos": {
      "post": {
        "tags": ["💳 Thanh toán (PayOS)"],
        "summary": "Webhook PayOS — cập nhật trạng thái thanh toán",
        "description": "⚠️ **Chỉ PayOS server gọi. Mobile app KHÔNG gọi endpoint này.** Khi thanh toán thành công, PayOS tự động POST vào đây để cập nhật trạng thái hóa đơn và gửi push notification.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Payload từ PayOS server (tham khảo tài liệu PayOS)",
                "properties": {
                  "code":     { "type": "string",  "example": "00" },
                  "orderCode":{ "type": "integer", "example": 12345 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Xử lý thành công (luôn trả 200 để PayOS không retry)" }
        }
      }
    }

  }

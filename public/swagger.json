{
  "openapi": "3.0.3",
  "info": {
    "title": "SmartRent API",
    "description": "API cho ứng dụng Mobile (Manager & Tenant). Tất cả endpoint có gắn `security` đều yêu cầu header `Authorization: Bearer <access_token>`. Lấy token bằng cách gọi `POST /api/auth/login`.\n\n**Phân quyền:**\n- `super_admin` — toàn quyền.\n- `manager` — chỉ thao tác dữ liệu thuộc chi nhánh được gán.\n- `tenant` — chỉ xem dữ liệu phòng mình đang thuê.",
    "version": "1.0.0",
    "contact": {
      "name": "SmartRent Support"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Môi trường phát triển"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Lấy từ `POST /api/auth/login` → trường `access_token`"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "Unauthorized" }
        }
      },
      "Success": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["phone", "password"],
        "properties": {
          "phone": {
            "type": "string",
            "description": "SĐT đăng nhập (0xxx hoặc +84xxx). Cũng chấp nhận email trực tiếp.",
            "example": "0901234567"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "Mật khẩu (tối thiểu 6 ký tự)",
            "example": "password123"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "access_token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIs..." },
          "refresh_token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIs..." },
          "user": {
            "type": "object",
            "properties": {
              "id":       { "type": "string", "format": "uuid", "description": "UUID trong auth.users" },
              "phone":    { "type": "string" },
              "email":    { "type": "string" },
              "role":     { "type": "string", "enum": ["super_admin", "manager", "tenant"] },
              "branch_id":{ "type": "integer", "nullable": true },
              "full_name":{ "type": "string", "nullable": true }
            }
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": ["new_password"],
        "properties": {
          "new_password": {
            "type": "string",
            "format": "password",
            "description": "Mật khẩu mới (tối thiểu 6 ký tự)",
            "example": "newPassword456"
          }
        }
      },
      "ChangePasswordResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string", "example": "Đổi mật khẩu thành công" }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email đã đăng ký với tài khoản",
            "example": "user@example.com"
          }
        }
      },
      "ForgotPasswordResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string", "example": "Đã gửi email khôi phục mật khẩu. Vui lòng kiểm tra hộp thư của bạn." }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": ["phone", "password", "role", "email"],
        "properties": {
          "phone": {
            "type": "string",
            "example": "0912345678",
            "description": "SĐT (0xxx hoặc +84xxx)"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "initialPass123"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "full_name": {
            "type": "string",
            "example": "Nguyễn Văn A"
          },
          "role": {
            "type": "string",
            "enum": ["manager", "tenant"],
            "example": "tenant",
            "description": "Manager chỉ được tạo role=tenant"
          },
          "branch_id": {
            "type": "integer",
            "nullable": true,
            "example": 1,
            "description": "Bắt buộc với manager & tenant. Manager bị bỏ qua field này (tự gán branch của mình)"
          },
          "room_id": {
            "type": "integer",
            "nullable": true,
            "example": 1,
            "description": "Gán luôn vào phòng khi tạo tenant (tùy chọn)"
          }
        }
      },
      "CreateUserResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "user": {
            "type": "object",
            "properties": {
              "id":        { "type": "string", "format": "uuid" },
              "phone":     { "type": "string" },
              "role":      { "type": "string" },
              "branch_id": { "type": "integer", "nullable": true }
            }
          }
        }
      },
      "Room": {
        "type": "object",
        "properties": {
          "id":          { "type": "integer", "example": 1 },
          "roomCode":    { "type": "string",  "example": "101" },
          "floor":       { "type": "integer", "example": 1 },
          "area":        { "type": "number",  "example": 25 },
          "basePrice":   { "type": "integer", "example": 3500000 },
          "electricPrice": { "type": "integer", "example": 4000 },
          "waterPrice":  { "type": "integer", "example": 15000 },
          "status":      { "type": "string", "enum": ["available", "occupied", "maintenance"] },
          "branch":      { "type": "integer", "description": "branch_id" },
          "tenant": {
            "nullable": true,
            "type": "object",
            "properties": {
              "id":       { "type": "integer" },
              "name":     { "type": "string" },
              "phone":    { "type": "string" },
              "check_in_date": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "RoomListResponse": {
        "type": "object",
        "properties": {
          "success":    { "type": "boolean" },
          "docs":       { "type": "array", "items": { "$ref": "#/components/schemas/Room" } },
          "totalDocs":  { "type": "integer" },
          "limit":      { "type": "integer" },
          "page":       { "type": "integer" },
          "totalPages": { "type": "integer" }
        }
      },
      "RoomDetailResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": {
            "type": "object",
            "properties": {
              "id":           { "type": "integer" },
              "roomCode":     { "type": "string" },
              "floor":        { "type": "integer" },
              "area":         { "type": "number" },
              "basePrice":    { "type": "integer" },
              "electricPrice":{ "type": "integer" },
              "waterPrice":   { "type": "integer" },
              "status":       { "type": "string" },
              "tenant": {
                "nullable": true,
                "type": "object",
                "properties": {
                  "id":          { "type": "integer" },
                  "name":        { "type": "string" },
                  "phone":       { "type": "string" },
                  "checkInDate": { "type": "string" }
                }
              },
              "invoices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id":            { "type": "integer" },
                    "totalAmount":   { "type": "number" },
                    "paymentStatus": { "type": "string" },
                    "issuedAt":      { "type": "string", "format": "date-time" }
                  }
                }
              },
              "tickets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id":       { "type": "integer" },
                    "title":    { "type": "string" },
                    "priority": { "type": "string" },
                    "status":   { "type": "string" },
                    "createdAt":{ "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      },
      "Branch": {
        "type": "object",
        "properties": {
          "id":   { "type": "integer" },
          "name": { "type": "string" }
        }
      },
      "BranchListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "docs":    { "type": "array", "items": { "$ref": "#/components/schemas/Branch" } }
        }
      },
      "Tenant": {
        "type": "object",
        "properties": {
          "id":          { "type": "integer" },
          "name":        { "type": "string" },
          "phone":       { "type": "string" },
          "checkInDate": { "type": "string" },
          "isRoomHead":  { "type": "boolean" },
          "initial":     { "type": "string" }
        }
      },
      "TenantListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "docs":    { "type": "array", "items": { "$ref": "#/components/schemas/Tenant" } }
        }
      },
      "TenantMeResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": {
            "type": "object",
            "properties": {
              "tenant_id":    { "type": "integer" },
              "user_id":      { "type": "string", "format": "uuid" },
              "full_name":    { "type": "string" },
              "phone":        { "type": "string" },
              "email":        { "type": "string" },
              "move_in_date": { "type": "string", "format": "date-time" },
              "move_out_date":{ "type": "string", "format": "date-time", "nullable": true },
              "status":       { "type": "string", "enum": ["active", "past"] },
              "room": {
                "nullable": true,
                "type": "object",
                "properties": {
                  "id":         { "type": "integer" },
                  "room_code":  { "type": "string" },
                  "base_price": { "type": "number" },
                  "area":       { "type": "number" },
                  "floor":      { "type": "integer" },
                  "branch_name":{ "type": "string" }
                }
              },
              "active_contract": {
                "nullable": true,
                "type": "object",
                "properties": {
                  "id":             { "type": "integer" },
                  "deposit_amount": { "type": "number" },
                  "start_date":     { "type": "string", "format": "date-time" },
                  "end_date":       { "type": "string", "format": "date-time", "nullable": true }
                }
              },
              "recent_invoices":    { "type": "array", "items": { "type": "object" } },
              "maintenance_tickets":{ "type": "array", "items": { "type": "object" } }
            }
          }
        }
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "id":          { "type": "integer" },
          "title":       { "type": "string" },
          "description": { "type": "string" },
          "status":      { "type": "string", "enum": ["pending", "in-progress", "resolved"] },
          "priority":    { "type": "string", "enum": ["low", "medium", "high"] },
          "images":      { "type": "array", "items": { "type": "string", "format": "uri" } },
          "created_at":  { "type": "string", "format": "date-time" },
          "rooms": {
            "type": "object",
            "properties": { "id": { "type": "integer" }, "room_code": { "type": "string" } }
          },
          "tenants": {
            "type": "object",
            "properties": {
              "id":   { "type": "integer" },
              "user": { "type": "object", "properties": { "full_name": { "type": "string" }, "phone": { "type": "string" } } }
            }
          }
        }
      },
      "TicketListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data":    { "type": "array", "items": { "$ref": "#/components/schemas/Ticket" } }
        }
      },
      "CreateTicketRequest": {
        "type": "object",
        "required": ["roomId", "title"],
        "properties": {
          "roomId":      { "type": "integer", "example": 1, "description": "ID phòng. Tenant không cần truyền (tự lấy từ hồ sơ)" },
          "tenantId":    { "type": "integer", "example": 5, "description": "ID khách thuê. Tenant không cần truyền." },
          "title":       { "type": "string", "example": "Đèn phòng bị hỏng", "description": "Tóm tắt sự cố (tối đa 100 ký tự)" },
          "description": { "type": "string", "example": "Đèn phòng ngủ không sáng." },
          "priority":    { "type": "string", "enum": ["low", "medium", "high"], "default": "medium" },
          "images":      { "type": "array", "items": { "type": "string", "format": "uri" }, "description": "Mảng URL ảnh đã tải lên Cloudinary" }
        }
      },
      "UpdateTicketStatusRequest": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["pending", "in-progress", "resolved"], "example": "resolved" }
        }
      },
      "UtilitySubmitRequest": {
        "type": "object",
        "required": ["roomId", "currentElectricity", "currentWater", "month", "year"],
        "properties": {
          "roomId":             { "type": "integer", "example": 1 },
          "currentElectricity": { "type": "number",  "example": 1523, "description": "Chỉ số điện kế hiện tại (kWh)" },
          "currentWater":       { "type": "number",  "example": 45,   "description": "Chỉ số nước hiện tại (m³)" },
          "month":              { "type": "integer", "example": 5,  "description": "Tháng (1–12)" },
          "year":               { "type": "integer", "example": 2026 }
        }
      },
      "UtilitySubmitResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": {
            "type": "object",
            "properties": {
              "log": {
                "type": "object",
                "description": "Bản ghi vừa lưu vào database"
              },
              "usage": {
                "type": "object",
                "properties": {
                  "electricity": { "type": "number", "example": 120 },
                  "water":       { "type": "number", "example": 5 }
                }
              },
              "anomaly": {
                "type": "object",
                "properties": {
                  "detected":  { "type": "boolean" },
                  "messages":  { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        }
      },
      "UploadSignatureResponse": {
        "type": "object",
        "properties": {
          "success":    { "type": "boolean" },
          "signature":  { "type": "string" },
          "timestamp":  { "type": "integer" },
          "folder":    { "type": "string" },
          "cloud_name":{ "type": "string" },
          "api_key":   { "type": "string" }
        }
      }
    }
  },
  "security": [],
  "tags": [
    { "name": "🔑 Xác thực (Auth)",       "description": "Đăng nhập, đổi mật khẩu, quên mật khẩu" },
    { "name": "👤 Quản lý Người dùng",    "description": "Tạo tài khoản manager/tenant" },
    { "name": "🏠 Phòng (Rooms)",         "description": "Danh sách và chi tiết phòng" },
    { "name": "🏢 Chi nhánh (Branches)",  "description": "Lấy danh sách chi nhánh" },
    { "name": "👥 Khách thuê (Tenants)",  "description": "Danh sách cư dân & hồ sơ cá nhân" },
    { "name": "🔧 Yêu cầu Bảo trì",       "description": "Gửi & xem yêu cầu bảo trì" },
    { "name": "⚡ Điện nước (Utility)",   "description": "Ghi chỉ số điện nước hàng tháng" },
    { "name": "📷 Tải ảnh (Upload)",      "description": "Lấy chữ ký upload ảnh lên Cloudinary" },
    { "name": "💳 Thanh toán (PayOS)",    "description": "Webhook — server-to-server, không dùng từ mobile" }
  ],
  "paths": {

    "/api/auth/login": {
      "post": {
        "tags": ["🔑 Xác thực (Auth)"],
        "summary": "Đăng nhập",
        "description": "Đăng nhập bằng SĐT (0xxx / +84xxx) hoặc email. Trả về `access_token` dùng cho tất cả API có bảo mật.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập thành công",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } }
          },
          "400": {
            "description": "Thiếu hoặc sai định dạng",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "Sai SĐT hoặc mật khẩu",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },

    "/api/auth/change-password": {
      "post": {
        "tags": ["🔑 Xác thực (Auth)"],
        "summary": "Đổi mật khẩu",
        "description": "Đổi mật khẩu tài khoản hiện tại. Yêu cầu `Authorization: Bearer <token>`.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangePasswordRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Đổi mật khẩu thành công",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangePasswordResponse" } } }
          },
          "400": { "description": "Mật khẩu mới quá ngắn", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Chưa đăng nhập",         "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },

    "/api/auth/forgot-password": {
      "post": {
        "tags": ["🔑 Xác thực (Auth)"],
        "summary": "Quên mật khẩu — gửi email khôi phục",
        "description": "Gửi email chứa liên kết khôi phục mật khẩu. Không yêu cầu đăng nhập.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ForgotPasswordRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Email đã được gửi",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ForgotPasswordResponse" } } }
          },
          "400": { "description": "Email không hợp lệ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },

    "/api/auth/callback": {
      "get": {
        "tags": ["🔑 Xác thực (Auth)"],
        "summary": "OAuth callback (nội bộ)",
        "description": "Endpoint nội bộ — Supabase gọi sau khi user xác thực OTP/email. Mobile app không dùng trực tiếp.",
        "security": []
      }
    },

    "/api/users/create": {
      "post": {
        "tags": ["👤 Quản lý Người dùng"],
        "summary": "Tạo tài khoản mới (Manager/Tenant)",
        "description": "Tạo tài khoản không cần OTP SMS.\n\n**Phân quyền:**\n- `super_admin` tạo được `manager` và `tenant`.\n- `manager` chỉ tạo được `tenant`, và tenant tự gán vào branch của manager.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateUserRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Tạo thành công",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateUserResponse" } } }
          },
          "400": { "description": "Thiếu thông tin bắt buộc hoặc SĐT/email đã tồn tại", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Chưa đăng nhập",                                                         "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Không có quyền tạo vai trò này",                                        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },

    "/api/rooms/list": {
      "get": {
        "tags": ["🏠 Phòng (Rooms)"],
        "summary": "Lấy danh sách phòng (có phân trang)",
        "description": "**Phân quyền:**\n- `super_admin`: Xem tất cả, lọc theo `branch_id`.\n- `manager`: Chỉ thấy phòng thuộc chi nhánh của mình.\n- `tenant`: Bị chặn (không được xem).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page",      "in": "query", "schema": { "type": "integer", "default": 1 },         "description": "Số trang" },
          { "name": "limit",     "in": "query", "schema": { "type": "integer", "default": 10 },         "description": "Số phần tử/trang (tối đa 100)" },
          { "name": "status",    "in": "query", "schema": { "type": "string", "enum": ["available","occupied","maintenance"] }, "description": "Lọc theo trạng thái" },
          { "name": "branch_id", "in": "query", "schema": { "type": "integer" },                         "description": "Lọc theo chi nhánh (chỉ super_admin)" },
          { "name": "search",    "in": "query", "schema": { "type": "string" },                          "description": "Tìm kiếm mờ theo mã phòng" },
          { "name": "floor",    "in": "query", "schema": { "type": "integer" },                          "description": "Lọc theo tầng" }
        ],
        "responses": {
          "200": { "description": "Thành công", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoomListResponse" } } } },
          "403": { "description": "Tenant không có quyền", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Chưa đăng nhập",        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },

    "/api/rooms/detail": {
      "get": {
        "tags": ["🏠 Phòng (Rooms)"],
        "summary": "Lấy chi tiết một phòng",
        "description": "Trả về thông tin phòng kèm cư dân, hóa đơn, và lịch sử báo hỏng.\n\n**Phân quyền:**\n- `manager` chỉ thấy phòng thuộc chi nhánh mình.\n- `tenant` chỉ thấy phòng đang thuê.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "query", "required": true, "schema": { "type": "integer" }, "description": "ID phòng" }
        ],
        "responses": {
          "200": { "description": "Thành công", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoomDetailResponse" } } } },
          "400": { "description": "Thiếu ID phòng",   "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Không có quyền",   "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Không tìm thấy",   "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Chưa đăng nhập",   "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },

    "/api/branches": {
      "get": {
        "tags": ["🏢 Chi nhánh (Branches)"],
        "summary": "Lấy danh sách chi nhánh",

        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Thành công", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BranchListResponse" } } } },
          "401": { "description": "Chưa đăng nhập", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },

    "/api/tenants": {
      "get": {
        "tags": ["👥 Khách thuê (Tenants)"],
        "summary": "Lấy danh sách cư dân",
        "description": "**Phân quyền:**\n- `super_admin`: Xem tất cả.\n- `manager`: Chỉ thấy cư dân thuộc chi nhánh mình.\n- `tenant`: Bị chặn.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Thành công", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TenantListResponse" } } } },
          "403": { "description": "Tenant không có quyền", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Chưa đăng nhập",        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },

    "/api/tenants/me": {
      "get": {
        "tags": ["👥 Khách thuê (Tenants)"],
        "summary": "Lấy hồ sơ cá nhân của người đang đăng nhập",
        "description": "Dành cho **Tenant app**. Trả về hồ sơ cá nhân, phòng đang thuê, hợp đồng, hóa đơn gần đây, và danh sách yêu cầu bảo trì.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Thành công", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TenantMeResponse" } } } },
          "404": { "description": "Không tìm thấy hồ sơ tenant", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
